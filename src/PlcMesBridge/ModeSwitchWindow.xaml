<Window x:Class="PlcMesBridge.ModeSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PlcMesBridge.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ModeSwitchViewModel, IsDesignTimeCreatable=False}"
        Icon="Assets/app.ico"
        Title="{Binding TitleText, FallbackValue='运行模式'}" Width="380" Height="270"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--运行模式切换窗（MVVM：状态走 ModeSwitchViewModel，本文件纯绑定）。
        单机/多机二选一 + 保存/取消；保存写 ini，模式变了由主窗自动重启。
        设计时 DataContext 为空，展示文本取 FallbackValue 占位（仅预览，运行时走真值）。-->
    <StackPanel Margin="20,14">
        <Label Content="{Binding HeadText, FallbackValue='运行模式'}"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <RadioButton Content="{Binding SingleText, FallbackValue='单机固化收料'}" IsChecked="{Binding IsSingle}"
                     Margin="8,10,8,4" FontSize="14"/>
        <RadioButton Content="{Binding MultiText, FallbackValue='多机通用网关'}" IsChecked="{Binding IsMulti}"
                     Margin="8,4" FontSize="14"/>
        <Border Style="{StaticResource FreshHintBorder}" Margin="0,12">
            <Label Content="{Binding HintText, FallbackValue='切换模式保存后自动重启软件'}"
                   Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="{Binding SaveText, FallbackValue='保存'}" Width="100" Height="36"
                    Margin="4" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText, FallbackValue='取消'}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
