<Window x:Class="PlcMesBridge.ModeSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="380" Height="270"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--运行模式切换窗（MVVM：状态走 ModeSwitchViewModel，本文件纯绑定）。
        单机/多机二选一 + 保存/取消；保存写 ini，模式变了由主窗自动重启。-->
    <StackPanel Margin="20,14">
        <Label Content="{Binding HeadText}"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <RadioButton Content="{Binding SingleText}" IsChecked="{Binding IsSingle}"
                     Margin="8,10,8,4" FontSize="14"/>
        <RadioButton Content="{Binding MultiText}" IsChecked="{Binding IsMulti}"
                     Margin="8,4" FontSize="14"/>
        <Border Style="{StaticResource FreshHintBorder}" Margin="0,12">
            <Label Content="{Binding HintText}"
                   Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="{Binding SaveText}" Width="100" Height="36"
                    Margin="4" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
