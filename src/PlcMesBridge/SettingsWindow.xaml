<Window x:Class="PlcMesBridge.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="380" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--设置窗（登录通过后：单机/多机二选一 + 保存/取消；保存写 ini，重启生效）。
        天蓝色小清新：深蓝标题 + 选项白底 + 浅蓝提示条。-->
    <StackPanel Margin="20,14">
        <Label x:Name="LbMode" Content="运行模式"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <RadioButton x:Name="RbSingle" Content="单机固化收料" Margin="8,10,8,4" FontSize="14"/>
        <RadioButton x:Name="RbMulti" Content="多机通用网关" Margin="8,4" FontSize="14"/>
        <Border Style="{StaticResource FreshHintBorder}" Margin="0,12">
            <Label x:Name="LbHint" Content="切换模式保存后自动重启软件"
                   Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button x:Name="BtnSave" Content="保存" Width="100" Height="36"
                    Margin="4" Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="取消" Width="100" Height="36"
                    Margin="4" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
