<Window x:Class="PlcMesBridge.MesDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="MES 接口调试界面" Width="834" Height="560"
        WindowStartupLocation="CenterScreen">
    <!--调试窗（1:1 单机版 FormMESDebug：接口下拉→动态表单显隐→JSON预览→手动上传）。
        融合版追加 API0033（不良明细，15 字段，定义见 xaml.cs 顶部注释）。-->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Label x:Name="LbApi" Content="接口类型:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbApi" Width="140" Height="28"
                      SelectionChanged="CmbApi_Changed"/>
            <Button x:Name="BtnSave" Content="保存参数到本地" Width="130" Height="30"
                    Margin="12,0,0,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnUpload" Content="手动上传到MES" Width="130" Height="30"
                    Margin="8,0,0,0" Background="#1E88E5" Foreground="White"
                    Click="BtnUpload_Click"/>
            <Button x:Name="BtnLang" Content="English" Width="70" Height="30"
                    Margin="8,0,0,0" Click="BtnLang_Click"/>
        </StackPanel>
        <Label x:Name="LbResp" Content="MES 返回信息:" DockPanel.Dock="Bottom"/>
        <TextBox x:Name="TxtResp" DockPanel.Dock="Bottom" Height="110"
                 IsReadOnly="True" Background="#F0F0F0" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"/>
        <Label x:Name="LbPreview" Content="发送报文预览:" DockPanel.Dock="Bottom"/>
        <TextBox x:Name="TxtPreview" DockPanel.Dock="Bottom" Height="52"
                 IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="PanelParams"/>
        </ScrollViewer>
    </DockPanel>
</Window>
