<Window x:Class="PlcMesBridge.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="640" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--PLC 配置窗（MVVM：三页走 PlcConfigViewModel，本文件纯绑定）。
        行内测试按钮经 RelativeSource 找父 VM 命令（DataTemplate 内 DataContext
        是行 VM，命令在父 VM，这是标准写法）。-->
    <DockPanel Margin="16,12">
        <Border Style="{StaticResource FreshHintBorder}" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Label Content="{Binding HintText}"
                   Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="{Binding SaveText}" Width="120" Height="36"
                    Margin="4" Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
        <TabControl>
            <!--单机页-->
            <TabItem Header="{Binding TabSingleText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ItemsControl ItemsSource="{Binding SingleRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Label Content="{Binding Caption}" Width="110"
                                               VerticalContentAlignment="Center"/>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="{Binding BoxWidth}" Height="28"
                                                 VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Button Content="{Binding DataContext.TestText,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    Width="100" Height="30" Margin="114,0,8,0"
                                    Command="{Binding TestSingleCommand}"/>
                            <TextBox Text="{Binding SingleResultText, Mode=OneWay}"
                                     Foreground="{Binding SingleResultForeground}"
                                     Width="330" Height="30" IsReadOnly="True"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Button Content="{Binding RestoreText}" Width="100" Height="30"
                                Margin="114,8,0,0" HorizontalAlignment="Left"
                                Command="{Binding RestoreSingleCommand}"
                                Style="{StaticResource FreshCancelButton}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!--多机页-->
            <TabItem Header="{Binding TabMultiText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ItemsControl ItemsSource="{Binding Stations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <CheckBox Content="{Binding TitleText}"
                                                  IsChecked="{Binding Enabled}" Width="90"
                                                  VerticalContentAlignment="Center"/>
                                        <TextBox Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="130" Height="28"
                                                 VerticalContentAlignment="Center"
                                                 Margin="4,0,0,0"/>
                                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="60" Height="28"
                                                 VerticalContentAlignment="Center"
                                                 Margin="4,0,0,0"/>
                                        <ComboBox ItemsSource="{Binding DataContext.ProtoOptions,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedIndex="{Binding ProtoIndex}"
                                                  Width="80" Height="28" Margin="4,0,0,0"/>
                                        <Button Content="{Binding DataContext.TestText,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                Width="70" Height="28" Margin="4,0,0,0"
                                                Command="{Binding DataContext.TestStationCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"/>
                                        <Label Content="{Binding ResultText}"
                                               Foreground="{Binding ResultForeground}"
                                               ToolTip="{Binding ResultTip}"
                                               Width="120" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding TestAllText}" Width="100" Height="30"
                                    Command="{Binding TestAllStationsCommand}"/>
                            <Button Content="{Binding RestoreText}" Width="100" Height="30"
                                    Margin="8,0,0,0" Command="{Binding RestoreStationsCommand}"
                                    Style="{StaticResource FreshCancelButton}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!--接口地址页-->
            <TabItem Header="{Binding TabApiText}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <Label Content="{Binding DataLengthLabel}" Width="110"
                                   VerticalContentAlignment="Center"/>
                            <TextBox Text="{Binding DataLengthText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ApiSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Label Content="{Binding ApiCode}" FontWeight="Bold"
                                               Foreground="#1565C0" Margin="0,8,0,0"/>
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                        <Label Content="{Binding Caption}" Width="110"
                                                               VerticalContentAlignment="Center"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="{Binding BoxWidth}" Height="28"
                                                                 VerticalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
