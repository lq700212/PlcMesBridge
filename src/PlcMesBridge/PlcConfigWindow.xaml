<Window x:Class="PlcMesBridge.PlcConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="PLC配置" Width="640" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--PLC 配置窗（三页：单机 / 多机 / 接口地址；填表→测试连接变绿→保存重启）。
        现场零写代码：IP/端口/命令地址全在界面改，保存时校验格式。
        天蓝色小清新：沿用全局 FreshBlue 样式与设置窗同一排版。-->
    <DockPanel Margin="16,12">
        <Border Style="{StaticResource FreshHintBorder}" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Label x:Name="LbHint" Content="测试连接用表单值直测，不用先保存；保存后自动重启生效"
                   Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                    DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="BtnSave" Content="保存并重启" Width="120" Height="36"
                    Margin="4" Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="取消" Width="100" Height="36"
                    Margin="4" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
        <TabControl x:Name="TabMain">
            <TabItem x:Name="TabSingle" Header="单机PLC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelSingle" Margin="8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabMulti" Header="多机PLC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelMulti" Margin="8"/>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabApi" Header="接口地址">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelApi" Margin="8"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
