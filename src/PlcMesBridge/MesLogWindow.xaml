<Window x:Class="PlcMesBridge.MesLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="MES 交互实时日志" Width="784" Height="561" Topmost="True">
    <!--日志窗（1:1 FormMESLogView：历史缓存一次性加载 + 订阅实时事件，关窗退订）。
        stationId=-1 单机全量；>=0 只看本机台（老项目 New(index) 语义）。-->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="BtnClear" Content="清空当前显示" Width="120" Height="30"
                    Margin="0,0,8,0" Click="BtnClear_Click"/>
            <Button x:Name="BtnLang" Content="English" Width="80" Height="30"
                    Click="BtnLang_Click"/>
        </StackPanel>
        <ListBox x:Name="BoxLogs" FontSize="12">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</Window>
