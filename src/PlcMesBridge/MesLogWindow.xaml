<Window x:Class="PlcMesBridge.MesLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="784" Height="561" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!--日志窗（MVVM：行集合走 MesLogViewModel，本文件纯绑定）。
        滚动到底部是纯视图行为，View 订阅集合变化调 ScrollIntoView。-->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{Binding ClearText}" Width="120" Height="30"
                    Margin="0,0,8,0" Command="{Binding ClearCommand}"/>
            <Button Content="{Binding LangText}" Width="80" Height="30"
                    Command="{Binding SwitchLanguageCommand}"/>
        </StackPanel>
        <ListBox x:Name="BoxLogs" FontSize="12" ItemsSource="{Binding Lines}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </DockPanel>
</Window>
