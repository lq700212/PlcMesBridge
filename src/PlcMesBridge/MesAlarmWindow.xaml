<Window x:Class="PlcMesBridge.MesAlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="800" Height="450" Topmost="True"
        WindowStartupLocation="CenterScreen">
    <!--报警窗（MVVM：展示走 MesAlarmViewModel，本文件纯绑定）。-->
    <DockPanel Margin="8">
        <Label Content="{Binding MachineName}" DockPanel.Dock="Top"/>
        <Button Content="{Binding CloseText}" Width="187" Height="41"
                DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,6,0,0"
                Command="{Binding CloseCommand}"/>
        <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </DockPanel>
</Window>
