<Window x:Class="PlcMesBridge.ImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="801" Height="560" WindowStartupLocation="CenterScreen">
    <!--图片查看（MVVM：展示走 ImageViewModel，本文件纯绑定）。-->
    <DockPanel>
        <Label Content="{Binding PathText}" DockPanel.Dock="Top" FontSize="12"/>
        <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
    </DockPanel>
</Window>
