<Window x:Class="PlcMesBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PlcMesBridge.Controls"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" WindowState="Maximized" Width="1230" Height="640">
    <!--主窗（MVVM：状态走 MainWindowViewModel，本文件纯绑定）。
        单机视图 = 单机版 Form1；多机视图 = 多机版 Form1。
        菜单门禁走 VM（admin/dev/未登录）；视图筛选下拉 = Form2/Form6"只看某几台"。-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!--顶菜单栏（单机/多机共用）-->
        <DockPanel Grid.Row="0" Background="{StaticResource FreshTopBarBrush}">
            <Menu DockPanel.Dock="Left" VerticalAlignment="Center"
                  FontFamily="微软雅黑" FontSize="14" Background="Transparent">
                <MenuItem Header="{Binding MiLogText}" Command="{Binding ShowLogCommand}"
                          Style="{StaticResource FreshMenuButton}"/>
                <MenuItem Header="{Binding MiDebugText}" Command="{Binding ShowDebugCommand}"
                          Style="{StaticResource FreshMenuButton}"/>
                <MenuItem Header="{Binding MiModeText}" Command="{Binding ShowModeCommand}"
                          Style="{StaticResource FreshMenuButton}"/>
                <!--注意：子项在 Popup 独立视觉树里，RelativeSource 找不到 Window；
                    DataContext 走逻辑树继承（与父菜单同 VM），直接绑 VM 属性。-->
                <MenuItem Header="{Binding MiSettingsText}"
                          Style="{StaticResource FreshMenuDropButton}">
                    <MenuItem Header="{Binding MiPlcText}"
                              Command="{Binding ShowPlcCommand}"
                              Visibility="{Binding PlcVisible,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                              Style="{StaticResource FreshMenuSubItem}"/>
                    <MenuItem Header="{Binding MiChangePwdText}"
                              Command="{Binding ShowChangePwdCommand}"
                              IsEnabled="{Binding SettingsItemEnabled}"
                              Style="{StaticResource FreshMenuSubItem}"/>
                    <MenuItem Header="{Binding MiShortcutText}"
                              Command="{Binding ShowShortcutCommand}"
                              IsEnabled="{Binding SettingsItemEnabled}"
                              Style="{StaticResource FreshMenuSubItem}"/>
                </MenuItem>
                <MenuItem Header="{Binding MiLangText}" Command="{Binding SwitchLanguageCommand}"
                          Style="{StaticResource FreshMenuButton}"/>
                <MenuItem Header="{Binding LoginHeader}" Command="{Binding LoginCommand}"
                          Style="{StaticResource FreshMenuButton}"/>
            </Menu>
            <Label DockPanel.Dock="Right" Content="{Binding ClockText}"
                   VerticalAlignment="Center" Margin="0,0,12,0"/>
        </DockPanel>

        <!-- ================= 单机视图 ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsSingleMode,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--左列：状态卡→统计卡→日志-->
            <DockPanel Grid.Column="0" Margin="6">
                <Border DockPanel.Dock="Top" Style="{StaticResource FreshHintBorder}">
                    <StackPanel TextBlock.FontFamily="微软雅黑" TextBlock.FontSize="14"
                                TextBlock.FontWeight="Bold">
                        <Label Content="{Binding StatusTitleText}" FontSize="15"
                               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Label Content="{Binding BeatLabel}" VerticalAlignment="Center"/>
                            <Label Content="⚫" Foreground="{Binding BeatLampColor}"
                                   VerticalAlignment="Center"/>
                            <Button Content="{Binding ConnectText}"
                                    IsEnabled="{Binding ConnectEnabled}"
                                    Command="{Binding ConnectSingleCommand}"
                                    Height="30" Padding="16,2" Margin="16,0,0,0"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                        <Label Content="{Binding CuringLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding InTimeLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding BinLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding StatusLine}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Top" Margin="0,8,0,0"
                        Style="{StaticResource FreshCardBorder}">
                    <StackPanel TextBlock.FontFamily="微软雅黑" TextBlock.FontSize="13"
                                TextBlock.FontWeight="Bold">
                        <Label Content="{Binding StatsTitleText}" FontSize="14"
                               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
                        <Label Content="{Binding TotalLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding DoneLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding RestingLine}" VerticalAlignment="Center"/>
                        <Label Content="{Binding TomorrowLine}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding LogLines}"
                         SelectedItem="{Binding SelectedLogLine}"
                         FontSize="12" Margin="0,8,0,0">
                    <ListBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding ShowLogDetailCommand}"/>
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>
            <!--右产品表（只读，产品号/产品ID，宋体12加粗）-->
            <DataGrid Grid.Column="1" ItemsSource="{Binding Products}" Margin="6"
                      Background="{Binding GridBackground}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" RowHeaderWidth="0"
                      RowHeight="25"
                      FontFamily="宋体" FontSize="14" FontWeight="Bold">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding DataContext.ColNoText,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        Binding="{Binding No}" Width="120"/>
                    <DataGridTextColumn Header="{Binding DataContext.ColIdText,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        Binding="{Binding ProductId}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ================= 多机视图 ================= -->
        <Grid Grid.Row="1" Visibility="{Binding IsMultiMode,
                    Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4"
                        VerticalAlignment="Center" Background="{StaticResource FreshTopBarBrush}">
                <Button Content="{Binding ConnectText}" IsEnabled="{Binding ConnectEnabled}"
                        Command="{Binding ConnectMultiCommand}"
                        Width="110" Height="32" Margin="4,2" VerticalAlignment="Center"/>
                <Label Content="视图:" VerticalAlignment="Center" Margin="12,0,2,0"/>
                <ComboBox ItemsSource="{Binding ViewOptions}"
                          SelectedIndex="{Binding SelectedViewIndex}"
                          Width="220" Height="30" VerticalAlignment="Center"
                          VerticalContentAlignment="Center"/>
                <Label Content="{Binding ScanCycleText}" Margin="16,0"
                       VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Stations}" Margin="4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.GridColumns,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ctrl:StationPanel Visibility="{Binding Visible,
                                    Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
