<Window x:Class="PlcMesBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PlcMesBridge.Controls"
        Title="PLC通信" WindowState="Maximized" Width="1230" Height="640">
    <!--主窗（单机视图 1:1 单机版 Form1；多机视图 1:1 多机版 Form1）。
        单机：状态带→统计带→左操作+日志/右160行产品表。
        多机：顶栏（连接/语言/调试+时钟+扫描周期+视图筛选）+ 8 机台面板。
        Form2/Form6 死窗体不复刻：视图筛选下拉 = 它们的"只看某几台"（补齐说明见 Core 注释）。-->
    <Grid>
        <!-- ================= 单机视图 ================= -->
        <Grid x:Name="SingleView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--状态带（微软雅黑16加粗，老项目原样）-->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        TextBlock.FontFamily="微软雅黑" TextBlock.FontSize="16"
                        TextBlock.FontWeight="Bold">
                <Label x:Name="LbBeat" Content="PLC心跳" Margin="8,2"/>
                <Label x:Name="LbBeatLamp" Content="⚫" Foreground="Gray"/>
                <Label x:Name="LbCuring" Content="固化时间: " Margin="20,2"/>
                <Label x:Name="LbInTime" Content="进入时间: " Margin="20,2"/>
                <Label x:Name="LbBin" Content="库位ID: " Margin="20,2"/>
                <Label x:Name="LbStatus" Content="物料状态" Margin="20,2"/>
            </StackPanel>
            <!--统计带（微软雅黑14加粗）-->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        TextBlock.FontFamily="微软雅黑" TextBlock.FontSize="14"
                        TextBlock.FontWeight="Bold">
                <Label x:Name="LbTotal" Content="库内总物料:" Margin="8,2"/>
                <Label x:Name="LbDone" Content="静置已完成:" Margin="20,2"/>
                <Label x:Name="LbResting" Content="正在静置:" Margin="20,2"/>
                <Label x:Name="LbTomorrow" Content="明日可完成:" Margin="20,2"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!--左操作区-->
                <DockPanel Grid.Column="0" Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button x:Name="BtnConnect" Content="连接PLC" Width="120" Height="48"
                                Margin="2" Click="BtnConnect_Click"/>
                        <Button x:Name="BtnLang" Content="English" Width="80" Height="48"
                                Margin="2" Click="BtnLang_Click"/>
                        <Button x:Name="BtnLog" Content="MES 交互实时日志" Width="130" Height="44"
                                Margin="2" Click="BtnLog_Click"/>
                        <Button x:Name="BtnDebug" Content="MES 接口调试界面" Width="130" Height="44"
                                Margin="2" Click="BtnDebug_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="BoxLog" FontSize="12"
                             MouseDoubleClick="BoxLog_DoubleClick"/>
                </DockPanel>
                <!--右产品表（只读，产品号/产品ID，宋体12加粗）-->
                <DataGrid Grid.Column="1" x:Name="GridProducts" Margin="6"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          FontFamily="宋体" FontSize="12" FontWeight="Bold">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColNo" Header="产品号"
                                            Binding="{Binding No}" Width="120"/>
                        <DataGridTextColumn x:Name="ColId" Header="产品ID"
                                            Binding="{Binding ProductId}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ================= 多机视图 ================= -->
        <Grid x:Name="MultiView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,4">
                <Button x:Name="BtnConnectM" Content="连接设备" Width="120" Height="40"
                        Margin="2" Click="BtnConnectM_Click"/>
                <Button x:Name="BtnLangM" Content="语言" Width="80" Height="40"
                        Margin="2" Click="BtnLang_Click"/>
                <Button x:Name="BtnDebugM" Content="MES 接口调试界面" Width="140" Height="40"
                        Margin="2" Click="BtnDebug_Click"/>
                <Label Content="视图:" VerticalAlignment="Center" Margin="12,0,2,0"/>
                <ComboBox x:Name="CmbView" Width="160" Height="30"
                          SelectionChanged="CmbView_Changed"/>
                <Label x:Name="LbCycle" Content="扫描周期: " Margin="16,0"
                       VerticalAlignment="Center"/>
                <Label x:Name="LbClock" Content="" VerticalAlignment="Center"/>
            </StackPanel>
            <UniformGrid Grid.Row="1" x:Name="StationGrid" Columns="4" Margin="4">
                <ctrl:StationPanel x:Name="St0"/><ctrl:StationPanel x:Name="St1"/>
                <ctrl:StationPanel x:Name="St2"/><ctrl:StationPanel x:Name="St3"/>
                <ctrl:StationPanel x:Name="St4"/><ctrl:StationPanel x:Name="St5"/>
                <ctrl:StationPanel x:Name="St6"/><ctrl:StationPanel x:Name="St7"/>
            </UniformGrid>
        </Grid>
    </Grid>
</Window>
