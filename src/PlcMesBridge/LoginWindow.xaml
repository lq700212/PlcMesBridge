<Window x:Class="PlcMesBridge.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/app.ico"
        Title="{Binding TitleText}" Width="340" Height="290"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--登录窗（MVVM：状态走 LoginViewModel，本文件纯绑定）。
        两档账号：admin（普通管理），dev（最高权限，设置下全选项）；
        记住密码跟随账号。PasswordBox 密码经 PasswordChanged 事件转交 VM
        （Password 非依赖属性不可绑定，见 LoginViewModel 注释）。-->
    <StackPanel Margin="20,14">
        <Label Content="{Binding HeadText}"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,4" VerticalAlignment="Center">
            <Label Content="{Binding UserLabel}" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUser"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Width="210" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <Label Content="{Binding PwdLabel}" Width="70" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtPwd" Width="210" VerticalAlignment="Center"
                         PasswordChanged="TxtPwd_Changed"/>
        </StackPanel>
        <CheckBox IsChecked="{Binding Remember}" Content="{Binding RememberText}"
                  Margin="70,6,0,0"
                  VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Label Content="{Binding Tip}" Foreground="Red" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button Content="{Binding OkText}" Width="100" Height="36"
                    Margin="4" Command="{Binding OkCommand}" IsDefault="True"/>
            <Button Content="{Binding CancelText}" Width="100" Height="36"
                    Margin="4" Command="{Binding CancelCommand}" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
