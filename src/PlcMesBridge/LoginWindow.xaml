<Window x:Class="PlcMesBridge.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录" Width="340" Height="290"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <!--登录窗（设置按钮门禁：用户名+密码，正确才进设置窗；模态）。
        天蓝色小清新：深蓝标题 + 白底输入 + 主/取消双色按钮。-->
    <StackPanel Margin="20,14">
        <Label x:Name="LbTitle" Content="请登录后进入设置"
               FontSize="16" FontWeight="Bold"
               Foreground="{StaticResource FreshPrimaryDeepBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,4" VerticalAlignment="Center">
            <Label x:Name="LbUser" Content="用户名" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUser" Width="210" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">
            <Label x:Name="LbPwd" Content="密码" Width="70" VerticalAlignment="Center"/>
            <PasswordBox x:Name="TxtPwd" Width="210" VerticalAlignment="Center"/>
        </StackPanel>
        <CheckBox x:Name="ChkRemember" Content="记住密码" Margin="70,6,0,0"
                  VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <Label x:Name="LbTip" Content="" Foreground="Red" Height="26"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
            <Button x:Name="BtnOk" Content="确定" Width="100" Height="36"
                    Margin="4" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="取消" Width="100" Height="36"
                    Margin="4" Click="BtnCancel_Click" IsCancel="True"
                    Style="{StaticResource FreshCancelButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
